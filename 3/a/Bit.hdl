// File name: projects/3/a/Bit.hdl
/**
 * 1-bit register:
 * If load is asserted, the register's value is set to in;
 * Otherwise, the register maintains its current value:
 * if (load(t)) out(t+1) = in(t), else out(t+1) = out(t)
 */
CHIP Bit {
    IN in, load;
    OUT out;

    PARTS:
    // Pick new value (in) if load is 1, otherwise keep feeding back the current stored value (out1).
    Mux(a=out1, b=in, sel=load, out=muxend);
    // Latch the chosen value on the clock edge; out1 feeds back into the mux for the "hold" case.
    DFF(in=muxend, out=out1, out=out);
}
